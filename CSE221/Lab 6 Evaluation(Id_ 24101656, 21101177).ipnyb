{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyOhKYnBYwVKUzFGhNRUhyuc"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","execution_count":3,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"OUczOXipe0cG","executionInfo":{"status":"ok","timestamp":1711337325812,"user_tz":-360,"elapsed":28851,"user":{"displayName":"MUAZ IBNE ASHRAF","userId":"12418138096115657743"}},"outputId":"93e95e01-3375-40ce-d14c-811eb7a6cd8f"},"outputs":[{"output_type":"stream","name":"stdout","text":["5 3 \n","3 1 4\n","1 2 0\n","3 1 4 2 0\n"]}],"source":["from collections import defaultdict, deque\n","\n","def lexicographically_largest_permutation(N, M, X, Y):\n","    graph = defaultdict(list)\n","    indegree = [0] * N\n","\n","    for i in range(M):\n","        graph[Y[i]].append(X[i])\n","        indegree[X[i]] += 1\n","\n","    queue = deque([node for node in range(N) if indegree[node] == 0])\n","    permutation_order = []\n","\n","    while queue:\n","        current_node = queue.popleft()\n","        permutation_order.append(current_node)\n","        for neighbor in graph[current_node]:\n","            indegree[neighbor] -= 1\n","            if indegree[neighbor] == 0:\n","                queue.append(neighbor)\n","\n","    if len(permutation_order) == N:\n","        permutation = reversed(permutation_order)\n","        return ' '.join(map(str, permutation))\n","    else:\n","        return -1\n","\n","\n","N, M = map(int, input().split())\n","X = list(map(int, input().split()))\n","Y = list(map(int, input().split()))\n","\n","print(lexicographically_largest_permutation(N, M, X, Y))"]}]}